local Settings = {
    AutoShoot = false, AimLock = true, ShowBeams = true, ShowLabels = true,
    Range = 5, Cooldown = 0.5, TeamFilter = "my",
}

local function myTeamLetter()
    local t = LP.Team
    if not t then return "A" end
    return t.Name:lower():find("b") and "B" or "A"
end

local function activeTeams()
    local mine = myTeamLetter()
    if Settings.TeamFilter == "my" then return { [mine] = true } end
    if Settings.TeamFilter == "enemy" then return { [mine == "A" and "B" or "A"] = true } end
    return { A = true, B = true }
end

local COLORS = {
    loft = Color3.fromRGB(0, 255, 100),
    bounce = Color3.fromRGB(255, 210, 0),
    curve = Color3.fromRGB(255, 130, 0),
}

local ROOT = Instance.new("Folder")
ROOT.Name = "LineupV8"
ROOT.Parent = Workspace

local Active = {}

local function basePart(name, size, cf, color, mat, trans)
    local p = Instance.new("Part")
    p.Name, p.Anchored, p.CanCollide, p.CanQuery, p.CastShadow = name, true, false, false, false
    p.Size, p.CFrame, p.Color, p.Material, p.Transparency = size, cf, color, mat, trans
    return p
end

local function buildStyle(styleName)
    if Active[styleName] then return Active[styleName] end
    local s = { boxes = {}, orbs = {}, beams = {}, labels = {}, spots = {}, folder = Instance.new("Folder") }
    s.folder.Name = styleName
    for teamLetter, list in pairs(Styles[styleName]) do
        for _, spot in ipairs(list) do
            local i = #s.spots + 1
            s.spots[i] = spot
            local col = COLORS[spot.shot] or COLORS.loft

            local box = basePart("Box", Vector3.new(8, 6, 6),
                CFrame.new(spot.stand) * CFrame.Angles(0, 0, math.rad(90)),
                col, Enum.Material.ForceField, 0.5)
            box.Shape = Enum.PartType.Cylinder
            box:SetAttribute("baseColor", col)
            box:SetAttribute("team", teamLetter)
            box.Parent = s.folder
            s.boxes[i] = box

            local orb = basePart("Orb", Vector3.new(4, 4, 4), CFrame.new(spot.aim), col, Enum.Material.Neon, 0.3)
            orb.Shape = Enum.PartType.Ball
            local l = Instance.new("PointLight")
            l.Color, l.Range, l.Brightness = col, 10, 2
            l.Parent = orb
            orb.Parent = s.folder
            s.orbs[i] = orb

            local dir = spot.aim - spot.stand
            local beam = basePart("Beam", Vector3.new(0.15, 0.15, dir.Magnitude),
                CFrame.lookAt((spot.stand + spot.aim) * 0.5, spot.aim), col, Enum.Material.Neon, 0.75)
            beam.Parent = s.folder
            s.beams[i] = beam

            local anchor = basePart("Anch", Vector3.new(0.1, 0.1, 0.1),
                CFrame.new(spot.stand + Vector3.new(0, 4.5, 0)),
                Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, 1)
            local bb = Instance.new("BillboardGui")
            bb.Size, bb.AlwaysOnTop, bb.Adornee = UDim2.fromScale(3, 1.2), true, anchor
            bb.Parent = anchor
            local tl = Instance.new("TextLabel")
            tl.Size, tl.BackgroundTransparency, tl.TextScaled = UDim2.fromScale(1, 1), 1, true
            tl.Font, tl.TextColor3, tl.TextStrokeTransparency = Enum.Font.GothamBold, col, 0.4
            tl.Text = styleName .. " " .. i .. " [" .. spot.shot .. "]"
            tl.Parent = bb
            anchor.Parent = s.folder
            s.labels[i] = bb
        end
    end
    Active[styleName] = s
    return s
end

local function refreshVisibility()
    local teams = activeTeams()
    for _, s in pairs(Active) do
        for i, spot in ipairs(s.spots) do
            local vis = teams[spot.team]
            s.boxes[i].Parent = vis and s.folder or nil
            s.orbs[i].Parent = vis and s.folder or nil
            s.beams[i].Parent = vis and s.folder or nil
            s.labels[i].Enabled = vis and Settings.ShowLabels
        end
        s.folder.Parent = ROOT
    end
end

local lastShoot = 0

local function aimDir(spot, hrp)
    if spot.shot == "bounce" then
        return (spot.aim - (hrp.Position + Vector3.new(0, 1.5, 0))).Unit
    end
    return (spot.aim - Cam.CFrame.Position).Unit
end

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local pos = hrp.Position
        local teams = activeTeams()

        local bestStyle, bestIdx, bestDist = nil, nil, Settings.Range
        for style, s in pairs(Active) do
            for i, spot in ipairs(s.spots) do
                if teams[spot.team] then
                    local d = (pos - spot.stand).Magnitude
                    if d < bestDist then bestStyle, bestIdx, bestDist = style, i, d end
                end
            end
        end

        for style, s in pairs(Active) do
            for i, box in ipairs(s.boxes) do
                local on = (style == bestStyle and i == bestIdx)
                if box:GetAttribute("hl") ~= on then
                    box:SetAttribute("hl", on)
                    if on then
                        box.Color = Color3.fromRGB(0, 150, 255)
                        box.Size = Vector3.new(8, 4, 4)
                        box.Transparency = 0.3
                    else
                        box.Color = box:GetAttribute("baseColor")
                        box.Size = Vector3.new(8, 6, 6)
                        box.Transparency = 0.5
                    end
                end
            end
        end

        if bestStyle then
            local spot = Active[bestStyle].spots[bestIdx]
            if Settings.AimLock then
                Cam.CFrame = CFrame.lookAt(Cam.CFrame.Position, Cam.CFrame.Position + aimDir(spot, hrp))
            end
            if Settings.AutoShoot and (tick() - lastShoot) >= Settings.Cooldown then
                lastShoot = tick()
                pcall(function()
                    VIM:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    task.wait(0.03)
                    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                end)
            end
        end
    end
end)

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()
local Window = Rayfield:CreateWindow({
    Name = "Lineup V8",
    LoadingTitle = "Loading...",
    ConfigurationSaving = { Enabled = true, FolderName = "LineupV8", FileName = "cfg" },
    Discord = { Enabled = false }, KeySystem = false,
})
local Tab = Window:CreateTab("Lineups", 4483362458)

Tab:CreateSection("Team")
Tab:CreateDropdown({
    Name = "Team Filter",
    Options = { "My Team", "Enemy Team", "Both" },
    CurrentOption = { "My Team" }, Flag = "TeamFilter",
    Callback = function(o)
        local v = type(o) == "table" and o[1] or o
        Settings.TeamFilter = (v == "Both") and "both" or (v == "Enemy Team") and "enemy" or "my"
        refreshVisibility()
    end,
})

Tab:CreateSection("Styles")
local styleNames = {}
for n in pairs(Styles) do table.insert(styleNames, n) end
table.sort(styleNames)
local styleToggles = {}
for _, n in ipairs(styleNames) do
    styleToggles[n] = Tab:CreateToggle({
        Name = n, CurrentValue = false, Flag = n .. "_on",
        Callback = function(v)
            if v then
                buildStyle(n)
                Active[n].folder.Parent = ROOT
            elseif Active[n] then
                Active[n].folder.Parent = nil
                Active[n] = nil
            end
            refreshVisibility()
        end,
    })
end
Tab:CreateToggle({
    Name = "All Styles", CurrentValue = false, Flag = "AllOn",
    Callback = function(v) for _, t in pairs(styleToggles) do t:Set(v) end end,
})

Tab:CreateSection("Aim")
Tab:CreateSlider({ Name = "Range", Range = {1,20}, Increment = 1, Suffix = " studs",
    CurrentValue = 5, Flag = "Rng", Callback = function(v) Settings.Range = v end })
Tab:CreateSlider({ Name = "Cooldown", Range = {0.05,2}, Increment = 0.05, Suffix = " s",
    CurrentValue = 0.5, Flag = "Cd", Callback = function(v) Settings.Cooldown = v end })
Tab:CreateToggle({ Name = "Aim Lock", CurrentValue = true, Flag = "AL",
    Callback = function(v) Settings.AimLock = v end })
Tab:CreateToggle({ Name = "Auto Shoot", CurrentValue = false, Flag = "AS",
    Callback = function(v) Settings.AutoShoot = v end })
Tab:CreateButton({ Name = "Unload", Callback = function()
    pcall(function() Rayfield:Destroy() end)
    if ROOT then ROOT:Destroy() end
end })
