-- ======================== MAIN LOOP ========================
task.spawn(function()
    while task.wait(0.1) do
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if not char or not root or not humanoid then continue end
        
        -- Speed Boost
        if _G.Features.SpeedBoost then
            humanoid.WalkSpeed = _G.Features.SpeedValue
        end
        
        -- Jump Boost
        if _G.Features.JumpBoost then
            humanoid.JumpPower = _G.Features.JumpValue
        end
        
        -- NoClip
        if _G.Features.NoClip then
            root.CanCollide = false
        else
            root.CanCollide = true
        end
        
        -- Fly
        if _G.Features.Fly then
            local bodyVelocity = root:FindFirstChild("FlyVelocity")
            if not bodyVelocity then
                bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.Name = "FlyVelocity"
                bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
                bodyVelocity.Parent = root
            end
            local moveDirection = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + root.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - root.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - root.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + root.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end
            bodyVelocity.Velocity = moveDirection * _G.Features.FlySpeed
        else
            local bodyVelocity = root:FindFirstChild("FlyVelocity")
            if bodyVelocity then bodyVelocity:Destroy() end
        end
        
        -- Freeze
        if _G.Features.Freeze then
            root.CFrame = root.CFrame
            root.Velocity = Vector3.new(0, 0, 0)
        end
        
        -- Infinite Jump
        if _G.Features.InfiniteJump then
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) and humanoid:GetState() == Enum.HumanoidStateType.Landed then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
        
        -- FOV Changer
        if _G.Features.FOV then
            workspace.CurrentCamera.FieldOfView = _G.Features.FOVValue
        end
        
        -- No Fog
        if _G.Features.NoFog then
            lighting = game:GetService("Lighting")
            lighting.FogEnd = 100000
            lighting.FogStart = 0
        end
        
        -- Bright
        if _G.Features.Bright then
            lighting = game:GetService("Lighting")
            lighting.Brightness = 10
            lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        end
        
        -- Invisible
        if _G.Features.Invisible then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Transparency = 1
                end
            end
        end
        
        -- Giant Mode
        if _G.Features.GiantMode then
            char:ScaleTo(3)
        end
        
        -- Tiny Mode
        if _G.Features.TinyMode then
            char:ScaleTo(0.3)
        end
        
        -- Spin
        if _G.Features.Spin then
            root.CFrame = root.CFrame * CFrame.Angles(0, 0.05, 0)
        end
        
        -- No Head
        if _G.Features.NoHead then
            local head = char:FindFirstChild("Head")
            if head then head:Destroy() end
        end
        
        -- No Torso
        if _G.Features.NoTorso then
            local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            if torso then torso:Destroy() end
        end
        
        -- Anti-Fall
        if _G.Features.AntiFall then
            humanoid.PlatformStand = true
            wait(0.05)
            humanoid.PlatformStand = false
        end
        
        -- Auto Sprint
        if _G.Features.AutoSprint then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        end
        
        -- No Sprint Stamina
        if _G.Features.NoSprintStamina then
            if humanoid:FindFirstChild("SprintStamina") then
                humanoid.SprintStamina.Value = 100
            end
        end
        
        -- FPS Unlock
        if _G.Features.FPSUnlock then
            setfpscap(999)
        end
    end
end)

